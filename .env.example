# Copy to .env to override defaults used by docker-compose.yml.

# Point the backend at a different listing source (must be reachable from the backend container).
# SOURCE_BASE_URL=http://host.docker.internal:4002
# SOURCE_MAX_RPS=4            # keep below the source's global limit (5/s by default)
# SOURCE_SEED=42              # repeatable random behaviour of the vendored source

# LLM: any OpenAI Chat Completions compatible endpoint. Empty LLM_BASE_URL disables summaries.
# Groq (free tier) was used during development:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_DAILY_CAP=2000
# LLM_TIMEOUT_MS=15000

# Scheduler
# POLL_INTERVAL_SECONDS=60        # base interval; production target is 900 (15 minutes)
# POLL_MAX_INTERVAL_SECONDS=240   # adaptive ceiling (default 4 x base; production e.g. 3600)
# POLL_BACKOFF_EVERY=10           # unchanged polls before the interval doubles
# LLM_PACE_HOURLY=true            # spread LLM_DAILY_CAP across the day
# RETENTION_DAYS=90
